//Without ^\n
#include<stdio.h>
int main()
{
    char ch[100];
    scanf("%s",ch);
    printf("%s",ch);
}

//With ^\n
#include<stdio.h>
int main()
{
    char ch[100];
    scanf("%[^\n]s",ch);
    printf("%s",ch);
}

//Length of string
