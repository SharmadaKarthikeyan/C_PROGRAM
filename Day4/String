#include<stdio.h>
#include<string.h>
int main()
{
    char arr[100];
    scanf("%[^\n]s",arr);
    int i,c=0;
    for(i=0;arr[i]!='\0';i++)
    {
        char ch = arr[i];
        if(ch==' ')
        c++;
    }
    printf("No of words in the string %d",(c+1));
}

#include<stdio.h>
#include<string.h>
int main()
{
    char arr[100];
    scanf("%[^\n]s",arr);
    int i,c=0;
    for(i=0;arr[i]!='\0';i++)
    {
        char ch = arr[i];
        if(ch=='a'||ch=='e'||ch=='i'||ch=='o'||ch=='u'||ch=='A'||ch=='E'||ch=='I'||ch=='O'||ch=='U')
        c++;
    }
    printf("vowels count : %d",c);
}
 
#include<stdio.h>
int main()
{
    char arr[100];
    scanf("%[^\n]s",arr);
    int i,c=0;
    for(i=0;arr[i]!='\0';i++)
    {
        char ch = arr[i];
        if(ch=='a'||ch=='e'||ch=='i'||ch=='o'||ch=='u'||ch=='A'||ch=='E'||ch=='I'||ch=='O'||ch=='U')
        continue;
        else
        c++;
    }
    printf("consonants count: %d",c);
}

#include<stdio.h>
int main()
{
    char arr[100];
    scanf("%[^\n]s",arr);
    int i;
    for(i=0;arr[i]!='\0';i++)
    {
        char ch=arr[i];
        if(ch>='A' && ch<='Z')
        printf("%c",ch+32);
        else if(ch>='a' && ch<='z')
        printf("%c",ch-32);
        else
        printf("%c",ch);
    }
}
